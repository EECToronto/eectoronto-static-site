---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Lang } from '../lib/site';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  current: string;
  image?: string;
}
const { lang, title, description, current, image } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead title={title} description={description} lang={lang} image={image} />
  </head>
  <body>
    <Header lang={lang} current={current} />
    <slot />
    <Footer lang={lang} />
  </body>
</html>
