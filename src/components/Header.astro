---
import { t, lpath, swapLang, type Lang } from '../lib/site';

interface Props {
  lang: Lang;
  current: string; // nav key of the active page
}
const { lang, current } = Astro.props;
const d = t(lang);
const links = [
  { key: 'home', href: lpath(lang, '/'), label: d.nav.home },
  { key: 'imNew', href: lpath(lang, '/im-new'), label: d.nav.imNew },
  { key: 'about', href: lpath(lang, '/about'), label: d.nav.about },
  { key: 'devotions', href: lpath(lang, '/devotions'), label: d.nav.devotions },
  { key: 'sermons', href: lpath(lang, '/sermons'), label: d.nav.sermons },
  { key: 'gatherings', href: lpath(lang, '/gatherings'), label: d.nav.gatherings },
  { key: 'giving', href: lpath(lang, '/giving'), label: d.nav.giving },
  { key: 'contact', href: lpath(lang, '/contact'), label: d.nav.contact },
];
---
<header class="site-header">
  <div class="header-inner">
    <a class="brand" href={lpath(lang, '/')} aria-label={d.churchName}>
      <span class="brand-mark" aria-hidden="true">✝</span>
      <span class="brand-name">
        {lang === 'am' ? 'የኢትዮጵያ ወንጌላዊት ቤተ ክርስቲያን' : 'Ethiopian Evangelical Church'}
        <small>{lang === 'am' ? 'ቶሮንቶ' : 'Toronto'}</small>
      </span>
    </a>
    <button class="menu-btn" id="menuBtn" aria-label="Menu" aria-expanded="false">☰</button>
    <nav class="nav" id="mainNav" aria-label="Main">
      {links.map((l) => (
        <a href={l.href} class={current === l.key ? 'active' : ''} aria-current={current === l.key ? 'page' : undefined}>
          {l.label}
        </a>
      ))}
      <a class="lang-toggle" href={swapLang(Astro.url.pathname, lang)}>
        {lang === 'en' ? 'አማርኛ' : 'English'}
      </a>
    </nav>
  </div>
</header>
<script>
  const btn = document.getElementById('menuBtn');
  const nav = document.getElementById('mainNav');
  btn?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open');
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
</script>
