---
import { t, lpath, type Lang } from '../lib/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="footer-grid">
    <div>
      <h4>{d.footer.visit}</h4>
      <p style="font-size:0.95rem">{d.footer.address}<br />{d.footer.phone}</p>
    </div>
    <div>
      <h4>{d.footer.explore}</h4>
      <ul>
        <li><a href={lpath(lang, '/im-new')}>{d.nav.imNew}</a></li>
        <li><a href={lpath(lang, '/about')}>{d.nav.about}</a></li>
        <li><a href={lpath(lang, '/gatherings')}>{d.nav.gatherings}</a></li>
        <li><a href={lpath(lang, '/ministries')}>{d.nav.ministries}</a></li>
      </ul>
    </div>
    <div>
      <h4>{d.footer.resources}</h4>
      <ul>
        <li><a href={lpath(lang, '/devotions')}>{d.nav.devotions}</a></li>
        <li><a href={lpath(lang, '/sermons')}>{d.nav.sermons}</a></li>
        <li><a href={lpath(lang, '/bible-study')}>{d.nav.bibleStudy ?? 'Bible Study'}</a></li>
        <li><a href={lpath(lang, '/giving')}>{d.nav.giving}</a></li>
      </ul>
    </div>
    <div>
      <h4>{d.nav.contact}</h4>
      <ul>
        <li><a href={lpath(lang, '/contact')}>{d.nav.contact}</a></li>
        <li><a href={lpath(lang, '/members')}>{lang === 'am' ? 'አዲስ አባላት' : 'New Members'}</a></li>
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    © {year} {d.churchName}. {d.footer.rights}
  </div>
</footer>
<div class="mobile-cta">
  <a class="btn btn-gold" href={lpath(lang, '/im-new')}>{d.hero.planVisit}</a>
  <a class="btn btn-outline" href={lpath(lang, '/giving')}>{d.hero.give}</a>
</div>
