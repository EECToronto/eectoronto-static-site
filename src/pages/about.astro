---
import Base from '../layouts/Base.astro';
import { t, lpath, type Lang } from '../lib/site';

const lang: Lang = 'en';
const d = t(lang);
const title = `${d.nav.about} | ${d.churchName}`;
const description = 'About the Ethiopian Evangelical Church in Toronto — our mission, statement of faith, and pastoral staff.';
---
<Base lang={lang} title={title} description={description} current="about">
  <section class="page-hero">
    <div class="wrap">
      <div class="breadcrumb"><a href={lpath(lang, '/')}>{d.nav.home}</a> / {d.nav.about}</div>
      <h1>{d.nav.about}</h1>
      <p>{description}</p>
    </div>
  </section>

  <section class="section tight">
    <div class="wrap">
      <span class="eyebrow">Our mission</span>
      <div class="prose">
        <blockquote>
          Preach the Gospel of Jesus Christ to the lost souls around us and live for His Kingdom
          by transforming lives through His Word.
        </blockquote>
        <p>
          The Ethiopian Evangelical Church in Toronto is a congregation of believers with an
          Ethiopian heart and a Toronto home. For decades we have gathered to worship in Amharic
          and English, to raise our families in faith, and to serve our city with the love of Christ.
        </p>
      </div>

      <span class="eyebrow" style="margin-top:3rem">Statement of faith</span>
      <div class="prose">
        <ul>
          <li>We believe the Bible — the Old and New Testaments — is the inspired, infallible, and authoritative Word of God, our sole rule for faith and life.</li>
          <li>We believe in one eternal God, existing in three persons: Father, Son, and Holy Spirit.</li>
          <li>We believe in the deity of Jesus Christ — His virgin birth, sinless life, sacrificial death, bodily resurrection, ascension, and His promised return.</li>
          <li>We believe salvation is by grace through faith in Jesus Christ alone, and that all who repent and believe are born again into new life.</li>
          <li>We believe in the present ministry of the Holy Spirit, who convicts, regenerates, indwells, and empowers believers for godly living and witness.</li>
          <li>We believe in baptism by immersion and the Lord's Supper as ordinances of the church.</li>
          <li>We believe in the resurrection of the dead — the believer to everlasting life and the unbeliever to everlasting separation from God.</li>
        </ul>
      </div>

      <span class="eyebrow" style="margin-top:3rem">Pastoral staff</span>
      <div class="staff-grid">
        <div class="staff-card">
          <div class="body">
            <h3>Pastor Tesfaye Moges</h3>
            <div class="role">Senior Pastor</div>
            <p>Leading the congregation in worship, teaching, and pastoral care.</p>
          </div>
        </div>
        <div class="staff-card">
          <div class="body">
            <h3>Pastor Birhanu Mekonnen</h3>
            <div class="role">Evangelist</div>
            <p>Leading evangelism and outreach to our community.</p>
          </div>
        </div>
        <div class="staff-card">
          <div class="body">
            <h3>Pastor Dereje Alemayehu</h3>
            <div class="role">Youth Ministry</div>
            <p>Shepherding the youth of the church in faith and fellowship.</p>
          </div>
        </div>
        <div class="staff-card">
          <div class="body">
            <h3>Pastor Tesfaye Tesfaye</h3>
            <div class="role">Family Ministry · Board of Elders</div>
            <p>Serving families and providing spiritual oversight with the elders.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
