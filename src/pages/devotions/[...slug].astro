---
import Base from '../../layouts/Base.astro';
import { t, lpath, type Lang } from '../../lib/site';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const devotions = await getCollection('devotions', (e) => e.data.lang === 'en');
  return devotions.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const lang: Lang = 'en';
const d = t(lang);
const { post } = Astro.props;
const { Content } = await render(post);
const title = `${post.data.title} | ${d.nav.devotions} | ${d.churchName}`;
const description = `${post.data.title} — a devotion from the Ethiopian Evangelical Church in Toronto.`;
---
<Base lang={lang} title={title} description={description} current="devotions">
  <section class="page-hero">
    <div class="wrap">
      <div class="breadcrumb">
        <a href={lpath(lang, '/')}>{d.nav.home}</a> /
        <a href={lpath(lang, '/devotions')}>{d.nav.devotions}</a> /
        {post.data.title}
      </div>
      <h1>{post.data.title}</h1>
      <p>{post.data.date}{post.data.category ? ` · ${post.data.category}` : ''}</p>
    </div>
  </section>
  <section class="section tight">
    <div class="wrap">
      <article class="prose">
        <Content />
      </article>
      <div class="btn-row">
        <a class="btn btn-outline" href={lpath(lang, '/devotions')}>{d.misc.allDevotions}</a>
      </div>
    </div>
  </section>
</Base>
