---
import Base from '../layouts/Base.astro';
import { t, lpath, type Lang } from '../lib/site';

const lang: Lang = 'en';
const d = t(lang);
const title = `${d.nav.ministries} | ${d.churchName}`;
const description = 'Ministries of the Ethiopian Evangelical Church in Toronto — children, youth, women, men, choir, evangelism, and prayer.';

const ministries = [
  { name: 'Children\u2019s Ministry', text: 'Raising our little ones in the knowledge and love of God through Sunday classes and activities.' },
  { name: 'Youth Ministry', text: 'Helping teens and young adults grow in faith, friendship, and purpose — led by Pastor Dereje Alemayehu.' },
  { name: 'Women\u2019s Ministry', text: 'Fellowship, encouragement, and spiritual growth for the women of the church.' },
  { name: 'Men\u2019s Ministry', text: 'Building men of faith through fellowship, accountability, and service.' },
  { name: 'Choir & Worship', text: 'Leading the congregation in heartfelt Amharic and English worship every week.' },
  { name: 'Evangelism & Outreach', text: 'Sharing the Gospel in our city and beyond — led by Pastor Birhanu Mekonnen.' },
  { name: 'Prayer Ministry', text: 'Standing in the gap through weekly congregational prayer and intercession.' },
  { name: 'Family Ministry', text: 'Strengthening marriages and families — led by Pastor Tesfaye Tesfaye with the Board of Elders.' },
];
---
<Base lang={lang} title={title} description={description} current="ministries">
  <section class="page-hero">
    <div class="wrap">
      <div class="breadcrumb"><a href={lpath(lang, '/')}>{d.nav.home}</a> / {d.nav.ministries}</div>
      <h1>{d.nav.ministries}</h1>
      <p>{description}</p>
    </div>
  </section>
  <section class="section tight">
    <div class="wrap">
      <div class="card-grid">
        {ministries.map((m) => (
          <div class="card">
            <h3>{m.name}</h3>
            <p>{m.text}</p>
          </div>
        ))}
      </div>
      <div class="note" style="margin-top:2.5rem">
        Want to serve in one of these ministries? <a href={lpath(lang, '/contact')}>Contact the church office</a> and we will connect you.
      </div>
    </div>
  </section>
</Base>
